# Root env — copy to .env (never commit .env)
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=insightforge
POSTGRES_DB=insightforge
POSTGRES_URL=postgresql://insightforge:insightforge@db:5432/insightforge
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
# LLM keys (API service uses these; leave empty for local mock mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
